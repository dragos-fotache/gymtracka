<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Defense in depth: the encrypted session vault lives under noBackupFilesDir,
             which the platform always excludes from backup. This rule additionally
             excludes the production vault namespace from cloud backup.
             Ordinary database backup behavior is unchanged. -->
        <exclude domain="root" path="no_backup/gymtracka-session-vault" />
    </cloud-backup>
    <device-transfer>
        <!-- Defense in depth: the encrypted session vault lives under noBackupFilesDir,
             which the platform always excludes from device transfer. This rule
             additionally excludes the production vault namespace from device transfer.
             Ordinary database backup behavior is unchanged. -->
        <exclude domain="root" path="no_backup/gymtracka-session-vault" />
    </device-transfer>
</data-extraction-rules>
