<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Defense in depth: the encrypted session vault lives under noBackupFilesDir,
         which the platform always excludes from backup and device transfer.
         This rule additionally excludes the production vault namespace from
         legacy full backup. Ordinary database backup behavior is unchanged. -->
    <exclude domain="root" path="no_backup/gymtracka-session-vault" />
</full-backup-content>
